{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Java",
            "type": "shell",
            "command": "javac",
            "args": [
                "-cp", "backend/src;backend/lib/*",
                "-d", "backend/bin",
                "-sourcepath", "backend/src",
                "backend/src/com/expensesplit/App.java"
            ],
            "group": "build",
            "problemMatcher": "$javac"
        },
        {
            "label": "Run Server",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp", "backend/bin;backend/lib/*",
                "com.expensesplit.App"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "Compile Java"
        }
    ]
}
